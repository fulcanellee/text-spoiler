{
  "name": "text-spoiler",
  "version": "0.1.0",
  "description": "React component that conceals text behind animated particles and reveals it like a spoiler",
  "keywords": [
    "react",
    "text",
    "spoiler",
    "particles",
    "canvas",
    "animation"
  ],
  "author": "fulcanellee",
  "license": "MIT",
  "homepage": "https://fulcanellee.github.io/text-spoiler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fulcanellee/text-spoiler.git"
  },
  "bugs": "https://github.com/fulcanellee/text-spoiler/issues",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./styles.css": "./dist/esm/TextSpoiler.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "build:lib": "node scripts/prepare-dist.mjs clean && tsc -p tsconfig.lib.json && tsc -p tsconfig.lib.cjs.json && node scripts/prepare-dist.mjs",
    "prepublishOnly": "npm run build:lib",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.7.2",
    "gh-pages": "^6.3.0",
    "prettier": "3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
